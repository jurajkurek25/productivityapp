DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Web push (daily reminder notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave unset to disable push notifications entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"
# Cron expression for when the daily reminder is sent (server-local time).
REMINDER_CRON="0 8 * * *"
# Optional: absolute or relative path to the built web app (apps/web/dist)
# to serve as static files at every non-/api route. Defaults to the sibling
# apps/web/dist directory in this monorepo. Only relevant when this server
# is the single process handling an entire domain (e.g. behind a reverse
# proxy that forwards everything to it, not just /api).
# WEB_DIST_PATH=../web/dist
